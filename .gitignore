# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
.vite/
coverage/

# Raw source clips: inputs to tools/transcode, deliberately not versioned.
# Their transcoded derivatives live in packages/assets and are the deliverable.
gifs/

# Throwaway measurement scripts from the design session
.probe/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Local env
*.local

# generated by scripts/sync-legal.mjs
packages/core/LICENSE
packages/vue/LICENSE
packages/assets/LICENSE
packages/assets/NOTICE

# Writer worktrees and wave reports: both live inside the workspace but are never
# part of the deliverable, and a worktree must not show up as untracked in the
# integration checkout.
.worktrees/
.waves/

# transcode scratch space
packages/assets/.work/

# generated by packages/demo/scripts/sync-clips.mjs
packages/demo/public/clips/
